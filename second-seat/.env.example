# Second Seat environment. Copy to `.env` at the repo root; both the web app and the bot read it.
# Everything is optional: with no values set, the app runs in demo mode with no paid services.

# ---------------------------------------------------------------- shared
# Demo mode: single local owner, simulated identity check, demo wallet top-ups, scripted demo meeting.
DEMO_MODE=true
# Shared secret between the web app and the bot service. Change it outside local dev.
BOT_SERVICE_TOKEN=dev-local-token

# Public demo: every visitor gets their own private sandbox (cookie-scoped), for a shared hosted link.
# Only takes effect together with DEMO_MODE=true.
PUBLIC_DEMO=false
# Hosting shortcut: sets WEB_DATA_DIR=$DATA_DIR/web and BOT_DATA_DIR=$DATA_DIR/bot in scripts/start.sh.
DATA_DIR=

# Product name shown across the UI. Compiled into the web build, so rebuild after changing it.
NEXT_PUBLIC_PRODUCT_NAME=Second Seat
NEXT_PUBLIC_COMPANY_NAME=Loving Grace

# ---------------------------------------------------------------- web app (apps/web, port 4310)
BOT_SERVICE_URL=http://127.0.0.1:4317
WEB_DATA_DIR=.data
# Public URL of the web app, used for OAuth redirect URIs.
APP_URL=http://localhost:4310
# Set to "false" to disable the calendar auto-join scheduler.
AUTO_JOIN_SCHEDULER=true
# Identity + liveness vendor (for example stripe_identity or persona). Empty = demo verification.
IDENTITY_PROVIDER=

# Card payments for minutes credit (Stripe Checkout). Empty = demo top-ups only.
# Never active when PUBLIC_DEMO=true. Use sk_test_ keys until sign-in is live (see docs/DEPLOY.md).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=

# One-tap connections. A connection with no credentials runs in demo mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---------------------------------------------------------------- bot service (services/bot, port 4317)
BOT_PORT=4317
BOT_PUBLIC_URL=http://localhost:4317
BOT_DATA_DIR=.data
# HMAC key for content credentials. Production should use a C2PA X.509 signing certificate.
CONTENT_CREDENTIALS_SECRET=dev-content-credentials-secret

# Billing and session safeguards
RATE_PER_MINUTE_CENTS=25
DEFAULT_SESSION_MINUTES=30
MAX_SESSION_MINUTES=60
DEMO_STARTING_BALANCE_CENTS=2000
GUARD_TICK_MS=250
# How long the twin waits for your live "Ask me" answer before promising a follow-up instead.
ASK_OWNER_TIMEOUT_MS=60000

# Answers: any OpenAI-compatible endpoint (vLLM, Ollama, a hosted API). Empty = retrieval-only answers from notes.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Self-hosted voice worker (OpenVoice V2, MIT). Empty = demo voice.
OPENVOICE_URL=
# Self-hosted avatar worker (LivePortrait + MuseTalk). Empty = demo avatar frames.
AVATAR_WORKER_URL=

# LiveKit (Apache-2.0) media transport for the avatar worker. Self-host or use LiveKit Cloud.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Meet: Playwright browser bot (install with `pnpm --filter @second-seat/bot add playwright`)
MEET_BOT_HEADLESS=true
# Google Meet fallback: Vexa (Apache-2.0), self-hosted or hosted, used when the browser bot cannot join.
VEXA_API_URL=
VEXA_API_KEY=

# Zoom Meeting SDK (needs a Zoom Marketplace app; see docs/PLATFORM_APPROVALS.md)
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=
ZOOM_MEETING_SDK_VERSION=3.13.2

# Microsoft Teams calling bot (Azure Bot registration + tenant admin consent)
TEAMS_TENANT_ID=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_SECRET=
TEAMS_CALLBACK_URL=
# Application-hosted media worker (.NET on Windows) for live video. Empty = Teams voice-only.
TEAMS_MEDIA_WORKER_URL=
