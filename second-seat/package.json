{
  "name": "second-seat",
  "version": "0.1.0",
  "private": true,
  "description": "Second Seat - an AI-native meeting twin (MVP)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n web,bot -c cyan,magenta \"pnpm --filter @second-seat/web dev\" \"pnpm --filter @second-seat/bot dev\"",
    "dev:web": "pnpm --filter @second-seat/web dev",
    "dev:bot": "pnpm --filter @second-seat/bot dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "licenses:scan": "node scripts/license-scan.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
