{
  "name": "@second-seat/bot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Second Seat meeting bot service: joins Google Meet, Zoom and Teams, runs the twin conversation loop and enforces session safeguards.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@second-seat/core": "workspace:*",
    "hono": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
